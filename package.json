{
  "name": "gistdb-sdk",
  "version": "0.1.0",
  "description": "GitHub Gist como backend leve para pequenos projetos browser",
  "type": "module",
  "main": "./src/GistDB.js",
  "exports": {
    ".": "./src/GistDB.js",
    "./crypto": "./src/CryptoManager.js",
    "./errors": "./src/errors.js"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules node --experimental-vm-modules node_modules/.bin/jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "build": "esbuild src/GistDB.ts --bundle --format=esm --outfile=dist/gistdb.min.js --minify"
  },
  "keywords": [
    "gist",
    "github",
    "database",
    "sync",
    "offline",
    "browser"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.2.4",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "moduleFileExtensions": ["ts","js","json","node"],
    "extensionsToTreatAsEsm": [".ts"]
  }
}
